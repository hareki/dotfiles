{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "dotfiles",
  "description": "Claude Code plugins scoped to the dotfiles repo",
  "owner": { "name": "hareki" },
  "plugins": [
    {
      "name": "nvim-lua-lsp",
      "description": "Lua language server that sees the Neovim runtime and the lazy.nvim plugin dir",
      "source": "./",
      "strict": false,
      "lspServers": {
        "lua": {
          "command": "lua-language-server",
          "extensionToLanguage": { ".lua": "lua" },
          "settings": {
            "Lua": {
              "runtime": { "version": "LuaJIT", "path": ["lua/?.lua", "lua/?/init.lua"] },
              "diagnostics": { "unusedLocalExclude": ["_*"] },
              "workspace": {
                "library": ["/opt/homebrew/share/nvim/runtime", "~/.local/share/nvim/lazy"],
                "checkThirdParty": false
              }
            }
          }
        }
      }
    }
  ]
}
