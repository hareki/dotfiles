{
  "permissions": {
    "allow": ["mcp__codegraph__*"]
  },
  "enabledPlugins": {
    "nvim-lua-lsp@dotfiles": true,
    "lua-lsp@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "dotfiles": {
      "source": {
        "source": "directory",
        "path": "./nvim/.config/nvim/.claude/marketplace"
      }
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  }
}
