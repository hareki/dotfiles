{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "EDITOR": "nvim",
    "NVIM_INTEGRATION": "claude-code"
  },
  "permissions": {
    "allow": [
      "Agent",
      "WebFetch",
      "Bash(grep:*)",
      "Bash(grep -R:*)",
      "Bash(rg:*)",
      "Bash(ripgrep:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(awk:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(gh issue view:*)",
      "Bash(* --version)",
      "Bash(* --help)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|worker_permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/bell.sh Funk"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/bell-when-done.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "syntaxHighlightingDisabled": false,
  "maxProseWidth": 100,
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh",
      "autoCompactWindow": "auto"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh",
      "autoCompactWindow": "auto"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": "auto"
    }
  },
  "tui": "fullscreen",
  "theme": "custom:catppuccin-mocha",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
