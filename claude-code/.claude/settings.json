{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "VISUAL": "nvim-claude"
  },
  "permissions": {
    "allow": [
      "Agent",
      "WebFetch",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(awk:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git log:*)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(gh issue view:*)",
      "Bash(* --version)",
      "Bash(* --help)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "AskUserQuestion"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": false,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|worker_permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/bell.sh Funk"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/nvim-bell-when-done.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/nvim-when-done.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/nvim-session-start.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "engineering@synced": false,
    "design@synced": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "claude-md-management@anthropic-plugin-directory": true
  },
  "outputStyle": "Concise",
  "maxProseWidth": 100,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": "auto"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": "auto"
    },
    "claude-fable-5-2": {
      "effortLevel": "high",
      "autoCompactWindow": "auto"
    }
  },
  "tui": "fullscreen",
  "theme": "custom:catppuccin-mocha",
  "editorMode": "vim",
  "idleCompaction": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
