# Multi-account GitHub SSH setup
# Shared defaults for plain github.com remotes and both aliases

Host github.com gh-personal gh-tonomo
  HostName github.com
  User git
  AddKeysToAgent yes
  IdentitiesOnly yes

Host github.com gh-personal
  IdentityFile ~/.ssh/id_ed25519_personal

Host gh-tonomo
  IdentityFile ~/.ssh/id_ed25519_tonomo
