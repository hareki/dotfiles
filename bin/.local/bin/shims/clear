#!/bin/sh
# macOS's clear (ncurses 5.7) finds no E3 in its tmux-256color entry, so inside
# tmux the scrollback survives a clear. Homebrew's ncurses (a dependency of
# brew's bash) sends E3 after the clear, which also drops the screen that tmux's
# scroll-on-clear just pushed into history
exec /opt/homebrew/opt/ncurses/bin/clear "$@"
