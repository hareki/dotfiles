#compdef gcloud gsutil bq

# Sources the SDK's bash completions on the first TAB instead of from .zshrc; they take
# over later TABs, and the guard stops a command they drop from recursing here forever
source /opt/homebrew/share/google-cloud-sdk/completion.zsh.inc \
  && [[ $_comps[$service] != _gcloud ]] \
  && eval $_comps[$service]
