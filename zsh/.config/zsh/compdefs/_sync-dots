#compdef sync-dots

local -a items=(
  '--help:Show usage info'
  '--list:Print package names'
  'all:Sync every package directory in $STOW_REPO'
)
local d

# Package directories under $STOW_REPO, minus the ones `sync-dots all` skips
for d in ${(f)"$(sync-dots --list)"}; do
  items+=("$d:Sync $d configs")
done

_describe 'stow directories' items
