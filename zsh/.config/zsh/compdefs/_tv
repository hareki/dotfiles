#compdef tv

local -a files
local cable_dir="$HOME/.config/television/cable"
local file_path

# Get list of files in cable directory and strip extensions
if [[ -d "$cable_dir" ]]; then
  for file_path in "$cable_dir"/*(.N); do
    files+=("${${file_path:t}%.*}")
  done
  _describe 'television cables' files
fi
