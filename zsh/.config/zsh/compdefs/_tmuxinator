#compdef tmuxinator
# https://raw.githubusercontent.com/tmuxinator/tmuxinator/master/completion/tmuxinator.zsh

# Mirror tmuxinator's config lookup: $TMUXINATOR_CONFIG, XDG dir, legacy ~/.tmuxinator
local -a config_dirs=(${TMUXINATOR_CONFIG:+$TMUXINATOR_CONFIG} ${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator ~/.tmuxinator)
local -aU projects=($^config_dirs/*.yml(N:t:r))

if (( CURRENT == 2 )); then
  # `tmuxinator commands` boots Ruby (>100ms); cache per shell since the
  # command set can't change mid-session
  (( $+_tmuxinator_commands )) || typeset -ga _tmuxinator_commands=(${(f)"$(tmuxinator commands zsh)"})
  _alternative \
    'commands:: _describe -t commands "tmuxinator subcommands" _tmuxinator_commands' \
    'projects:: _describe -t projects "tmuxinator projects" projects'
elif (( CURRENT == 3 )); then
  case $words[2] in
    copy|cp|c|debug|delete|rm|open|o|start|s|stop|edit|e)
      _arguments '*:projects:($projects)'
    ;;
  esac
fi
