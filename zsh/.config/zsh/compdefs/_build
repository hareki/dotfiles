#compdef build

local -a targets=(
  '--help:Show usage info'
  '--list:Print target names'
  '--up-to-date:Succeed if the installed target came from the checkout in the current directory'
  "all:Pull every target under ${(D)REPOS_DIR} and build the changed ones side by side"
)
local t
for t in ${(f)"$(build --list)"}; do
  targets+=("$t:Build the $t checkout in the current directory")
done
_describe 'build targets' targets
