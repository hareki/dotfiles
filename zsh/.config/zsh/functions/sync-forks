#!/bin/zsh

# Stand-in for the wei/pull GitHub app: merges upstream into each fork's default
# branch through the API behind GitHub's "Sync fork" button. The fork's clone under
# $REPOS_DIR, if any, is then fast-forwarded from origin, so it has the merge too.
# A conflicting merge leaves the fork untouched, so unless --no-local-merge it is
# started in the clone instead, with its conflicts ready to resolve and push
sync-forks() {
  local owner=hareki
  # Fork names (not upstream ones) whose drift is accepted, so they are skipped instead of synced
  local -a ignored=(eagle.nvim mason-registry maple-font)
  # Every state a sync can report, in the closing tally's order: how a fork's line
  # puts it (ahead of the detail), then how the tally does
  local -a states=(
    synced   '%F{green}synced%f with'        '%F{green}synced%f'
    none     'up to date'                    'up to date'
    ignored  '%F{yellow}ignored%f'           '%F{yellow}ignored%f'
    conflict '%F{red}merge conflict%f with'  '%F{red}conflicting%f'
    failed   '%F{red}failed%f,'              '%F{red}failed%f'
    pulled   '%F{green}pulled%f'             '%F{green}pulled%f'
    unpulled '%F{red}not pulled%f,'          '%F{red}not pulled%f'
    merging  '%F{yellow}merging%f in'        '%F{yellow}merging%f'
    unpushed '%F{yellow}unpushed merge%f in' '%F{yellow}unpushed%f'
    unmerged '%F{red}not merged%f,'          '%F{red}not merged%f'
  )
  local -a opt_jobs=(-j 10) opt_help opt_no_local_merge forks report parts synced conflicted failed unpulled move summary
  local -A counts phrases
  local jobs list name branch upstream oid result state detail msg label fifo slots dir ref tracking entry sep=$'\x1f'
  for state msg label in "${states[@]}"; do
    phrases[$state]=$msg
  done

  zparseopts -D -F -K -- j:=opt_jobs -jobs:=opt_jobs -no-local-merge=opt_no_local_merge -help=opt_help || return 1
  # zparseopts keeps the "=" of --jobs=N
  jobs=${opt_jobs[-1]#=}
  # Leftover arguments are rejected: `sync-forks <fork>` would otherwise sync every fork
  if (( $#opt_help || $# )) || [[ $jobs != <1-> ]]; then
    print "Usage: sync-forks [-j|--jobs <n>] [--no-local-merge]"
    print "Merge upstream into every fork of $owner, <n> forks at a time (default 10),"
    print "then fast-forward each fork's clone in ${(D)REPOS_DIR} from origin, or start"
    print "a conflicting merge in the clone instead (unless --no-local-merge)"
    return $(( ! $#opt_help ))
  fi

  # Scoped to this call instead of `gh auth switch`, which would flip the active
  # account under every other shell while this runs
  local -x GH_TOKEN
  GH_TOKEN=$(gh auth token --user $owner) || return 1

  # The GraphQL query behind `gh repo list`, plus each default branch's head, which
  # its --json can't return: a clone that already has the head skips its fetch.
  # isArchived filters on the server, without the search API that --no-archived uses (~1s)
  list=$(gh api graphql --paginate -f owner=$owner -f query='
    query($owner: String!, $endCursor: String) {
      repositoryOwner(login: $owner) {
        repositories(first: 100, isFork: true, isArchived: false, ownerAffiliations: OWNER, after: $endCursor) {
          nodes { name defaultBranchRef { name target { oid } } parent { nameWithOwner } }
          pageInfo { hasNextPage endCursor }
        }
      }
    }' --jq '.data.repositoryOwner.repositories.nodes[]
      | .name, .defaultBranchRef.name, .parent.nameWithOwner, .defaultBranchRef.target.oid') || return 1
  # gh prints a null field (an empty fork has no default branch) as an empty line, which
  # unquoted (f) would drop, shifting every later name/branch/upstream/head group
  [[ -n $list ]] && forks=("${(@f)list}")
  # The slots are pre-filled before anything reads them, and print blocks once they
  # exceed the FIFO's buffer (8KB on macOS), so they are capped at the fork count
  (( jobs > $#forks / 4 )) && jobs=$(( $#forks / 4 ))

  print-header "Syncing forks of $owner"
  # A FIFO pre-filled with one line per slot: each sync takes a line to start and
  # puts it back when done, so a slow merge never stalls the free slots (zargs -P
  # runs fixed batches, and zsh's wait has no -n). The subshell owns the FIFO's fd,
  # so nothing is left open in this shell, even on Ctrl-C
  {
    fifo=$(mktemp -u) && mkfifo $fifo && exec {slots}<>$fifo || exit 1
    rm $fifo
    repeat $jobs print -u $slots

    for name branch upstream oid in "${forks[@]}"; do
      if (( $ignored[(Ie)$name] )); then
        print -r -- $name${sep}ignored
        continue
      fi

      read -u $slots
      {
        result=$(gh api -X POST repos/$owner/$name/merge-upstream -f branch=$branch --jq .merge_type 2>&1)
        # On errors gh prints the raw body without a trailing newline, so its own
        # "gh: <message> (HTTP <code>)" line ends up glued to the end of it
        case $?,$result in
          0,none)         report=($name none '') ;;
          0,*)            report=($name synced "$upstream:$branch ($result)") ;;
          *'(HTTP 409)'*) report=($name conflict $upstream:$branch) ;;
          *)              report=($name failed "${result##*gh: }") ;;
        esac

        # Only a clone of this very fork is pulled (not a same-named repo cloned from
        # elsewhere), and only if it has the default branch locally
        dir=$REPOS_DIR/$name ref=refs/heads/$branch tracking=refs/remotes/origin/$branch
        if [[ -n $branch && $(git -C $dir remote get-url origin 2>/dev/null) == *[:/]$owner/$name(|.git) ]] \
          && git -C $dir show-ref -q --verify $ref; then
          # When GitHub merged nothing, a clone that already has the listed head skips
          # the fetch: an SSH round trip of ~3s that would bring nothing
          if [[ $report[2] != (none|conflict) || $(git -C $dir rev-parse -q --verify $tracking) != $oid ]] \
            && ! result=$(git -C $dir fetch -q origin $branch 2>&1); then
            report+=(unpulled "$result")
          # Nothing to pull: level with origin, or only ahead of it with unpushed commits
          elif git -C $dir merge-base --is-ancestor $tracking $ref; then
            :
          elif ! git -C $dir merge-base --is-ancestor $ref $tracking; then
            report+=(unpulled "diverged from origin/$branch")
          # Not checked out here, so only the ref has to move. Git refuses that while
          # another worktree has the branch checked out or is rebasing it
          elif [[ $(git -C $dir symbolic-ref -q HEAD) != $ref ]]; then
            move=(fetch -q . $tracking:$ref)
          elif [[ -n $(git -C $dir status --porcelain -uno) ]]; then
            report+=(unpulled "local changes")
          else
            move=(merge -q --ff-only $tracking)
          fi
          if (( $#move )); then
            if result=$(git -C $dir $move 2>&1); then
              report+=(pulled "$branch in ${(D)dir}")
            else
              report+=(unpulled "$result")
            fi
          fi

          # The merge GitHub refused is started on the clone's up-to-date branch, so
          # its conflicts are ready to resolve there
          if [[ $report[2] == conflict ]] && (( ! $#opt_no_local_merge && ! $report[(Ie)unpulled] )); then
            if [[ $(git -C $dir symbolic-ref -q HEAD) != $ref ]]; then
              report+=(unmerged "$branch not checked out")
            # Most likely started by an earlier run, and not concluded yet
            elif git -C $dir rev-parse -q --verify MERGE_HEAD >/dev/null; then
              report+=(merging ${(D)dir})
            elif [[ -n $(git -C $dir status --porcelain -uno) ]]; then
              report+=(unmerged "local changes")
            elif ! result=$(git -C $dir fetch -q https://github.com/$upstream.git $branch 2>&1); then
              report+=(unmerged "$result")
            # An earlier run's merge, concluded but not pushed yet
            elif git -C $dir merge-base --is-ancestor FETCH_HEAD $ref; then
              report+=(unpushed ${(D)dir})
            else
              # --no-commit, so a merge git completes on its own still stops for a
              # review, the same as a conflicting one
              result=$(git -C $dir merge -q --no-commit FETCH_HEAD 2>&1)
              if git -C $dir rev-parse -q --verify MERGE_HEAD >/dev/null; then
                report+=(merging ${(D)dir})
              else
                report+=(unmerged "$result")
              fi
            fi
          fi
        fi
        # A single print, so another fork's report can't land in the middle of this
        # one. Details hold spaces and may be empty, hence the $sep between fields, and
        # are cut to their first line, since git's and gh's errors can run over several
        print -r -- ${(pj:$sep:)report%%$'\n'*}
        print -u $slots
      } &
    done
    wait
  } | while IFS=$sep read -rA report; do
    # The syncs run in subshells, so they report as lines (the fork's name, then the
    # state and detail of the merge and of whatever happened to the clone) and the
    # tallying happens here, since zsh runs a pipeline's last command in the current shell
    name=$report[1] parts=()
    for state detail in "${(@)report[2,-1]}"; do
      (( ++counts[$state] ))
      [[ $state == unpulled ]] && unpulled+=("${(D)REPOS_DIR}/$name: $detail")
      # Only the fixed text goes through prompt expansion: $detail carries branch names
      # and API messages, and PROMPT_SUBST would run any $(...) in them
      parts+=("${(%)phrases[$state]}${detail:+ $detail}")
    done
    # Synced and conflicting forks are listed again at the end, along with what
    # happened to their clone, which is where a merge started there is resolved
    entry="https://github.com/$owner/$name${parts[2]:+: ${(j:, :)parts[2,-1]}}"
    case $report[2] in
      synced)   synced+=($entry) ;;
      conflict) conflicted+=($entry) ;;
      failed)   failed+=("$name: $report[3]") ;;
    esac
    msg="%F{blue}$name%f:"
    print -r -- ${(%)msg} ${(j:, :)parts}
  done
  (( pipestatus[1] )) && return 1

  if (( $#synced )); then
    print -P "\n%F{green}==> Synced with upstream:%f"
    print -rl -- "  "$^synced
  fi
  {
    if (( $#conflicted )); then
      print -P "\n%F{red}==> Merge conflicts, resolve them or add the fork to the ignore list:%f"
      print -rl -- "  "$^conflicted
    fi
    if (( $#failed )); then
      print -P "\n%F{red}==> Failed to sync:%f"
      print -rl -- "  "$^failed
    fi
    if (( $#unpulled )); then
      print -P "\n%F{red}==> Clones not pulled:%f"
      print -rl -- "  "$^unpulled
    fi
  } >&2

  for state msg label in "${states[@]}"; do
    (( counts[$state] )) && summary+=("$counts[$state] $label")
  done
  (( $#summary )) && print -P "\n%F{blue}==>%f ${(j:, :)summary}"
  (( ! $#conflicted && ! $#failed && ! $#unpulled ))
}
