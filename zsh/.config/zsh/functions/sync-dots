#!/bin/zsh

# Root-level package metadata (AGENTS.md, README.md, ...) is excluded via
# root-anchored patterns in stow/.stow-global-ignore
sync-dots () {
  local failed=0 dir
  # App settings exports that are imported by hand, not stowed into $HOME
  local -a ignored=(better-mouse simple-translate zen-browser)
  local -a packages=("$STOW_REPO"/*(/:t))
  packages=(${packages:|ignored})

  case "$1" in
    --list) print -l $packages; return 0 ;;
    --help|"")
      print "Usage: sync-dots <dir>..."
      print "       sync-dots all   # sync every package directory in \$STOW_REPO"
      return 0
      ;;
    all) set -- $packages ;;
  esac

  for dir in $@; do
    if [[ -d "$STOW_REPO/$dir" ]]; then
      print-header "Syncing $dir"
      stow -d "$STOW_REPO" -t "$HOME" "$dir" || { print -P "%F{red}==> Failed to sync $dir%f" >&2; failed=1; }
    else
      echo "Directory '$dir' does not exist in $STOW_REPO." >&2
      failed=1
    fi
  done

  return $failed
}
