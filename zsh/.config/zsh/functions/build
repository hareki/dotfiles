#!/bin/zsh

build() {
  local -a targets=(atuin eza television worktrunk lazygit fzf tmux)
  local target failed=0
  # In the toolchains' own dirs, mise would shim every binary (~25ms per call) and a go
  # upgrade would strand them; PATH puts this dir ahead of the mise shims instead
  local -x CARGO_INSTALL_ROOT=~/.local/opt GOBIN=~/.local/opt/bin

  case "$1" in
    --list) print -l $targets; return 0 ;;
    --help|"")
      print "Usage: build <target>"
      print "Available targets: all, ${(j:, :)targets}"
      return 0
      ;;
    all)
      # Each target's own build clears the evalcache
      for target in $targets; do
        print-header "Building $target"
        (cd $REPOS_DIR/$target && git pull && build $target) || { print -P "%F{red}==> Failed to build $target%f" >&2; failed=1; }
      done
      return $failed
      ;;
    # A failed build keeps its artifacts for debugging and as the retry's cache, while
    # `go install` leaves none in the repo (its build cache is the self-trimming GOCACHE)
    atuin)                    cargo install --locked --path crates/atuin && cargo clean ;;
    eza|television|worktrunk) cargo install --locked --path . && cargo clean ;;
    lazygit|fzf)              go install ;;
    tmux)
      # Explicit installs keep `brew autoremove` off the deps of a binary it can't see;
      # distclean leaves autogen.sh's outputs and the .deps dirs (stale .Po files) behind
      brew install libevent utf8proc jemalloc \
        && sh autogen.sh \
        && ./configure --enable-utf8proc --enable-jemalloc \
        && make clean \
        && make \
        && sudo make install \
        && make distclean \
        && rm -rf autom4te.cache aclocal.m4 configure configure~ Makefile.in etc \
          .deps compat/.deps fuzz/.deps
      ;;
    *)
      print "Unknown target: $1" >&2
      build --help
      return 1
      ;;
  esac

  local ret=$?
  _evalcache_clear
  return $ret
}
