#!/bin/zsh

build() {
  local -a targets=(atuin eza television worktrunk lazygit fzf tmux)
  local target failed=0
  # mise shims every binary in the toolchains' own dirs (~/.cargo/bin, the versioned
  # go bin), which costs ~50ms per call, and a go upgrade strands anything installed
  # there. PATH puts this dir ahead of the mise shims instead
  local -x CARGO_INSTALL_ROOT=~/.local/opt GOBIN=~/.local/opt/bin

  case "$1" in
    --list) print -l $targets; return 0 ;;
    --help|"")
      print "Usage: build <target>"
      print "Available targets: all, ${(j:, :)targets}"
      return 0
      ;;
    all)
      # Each target's own build clears the evalcache
      for target in $targets; do
        print-header "Building $target"
        (cd $REPOS_DIR/$target && git pull && build $target) || { print -P "%F{red}==> Failed to build $target%f" >&2; failed=1; }
      done
      return $failed
      ;;
    # Build artifacts are removed only once installed, so a failed build keeps them for
    # debugging and as the retry's cache. `go install` leaves nothing in the repo (its
    # build cache is the shared GOCACHE, which trims itself)
    atuin)                    cargo install --locked --path crates/atuin && cargo clean ;;
    eza|television|worktrunk) cargo install --locked --path . && cargo clean ;;
    lazygit|fzf)              go install ;;
    tmux)
      # Installing explicitly marks them installed_on_request, so `brew
      # autoremove` won't reap deps of a binary brew can't see. distclean leaves
      # autogen.sh's outputs and the .deps dirs (with stale .Po files) behind
      brew install libevent utf8proc jemalloc \
        && sh autogen.sh \
        && ./configure --enable-utf8proc --enable-jemalloc \
        && make clean \
        && make \
        && sudo make install \
        && make distclean \
        && rm -rf autom4te.cache aclocal.m4 configure configure~ Makefile.in etc \
          .deps compat/.deps fuzz/.deps
      ;;
    *)
      print "Unknown target: $1" >&2
      build --help
      return 1
      ;;
  esac

  local ret=$?
  _evalcache_clear
  return $ret
}
