#!/bin/zsh

build() {
  local -a targets=(atuin eza television worktrunk lazygit tmux)
  local target

  case "$1" in
    --list) print -l all $targets; return 0 ;;
    --help|"")
      print "Usage: build <target>"
      print "Available targets: all, ${(j:, :)targets}"
      return 0
      ;;
    all)
      for target in $targets; do
        print-header "Building $target"
        (cd $REPOS_DIR/$target && git pull && build $target) || print -P "%F{red}==> Failed to build $target%f" >&2
      done
      ;;
    atuin)      cargo install --locked --path crates/atuin ;;
    eza)        cargo install --locked --path . ;;
    television) cargo install --locked --path . ;;
    worktrunk)  cargo install --locked --path . ;;
    lazygit)    go install ;;
    tmux)
        sh autogen.sh \
        && ./configure --enable-utf8proc --enable-jemalloc \
        && make clean \
        && make \
        && sudo make install
      ;;
    *)
      print "Unknown target: $1" >&2
      build --help
      return 1
      ;;
  esac

  local ret=$?
  # Updated tools may emit different `eval "$(tool init)"` output; drop the
  # evalcaches so the next shell regenerates them
  rm -f "$ZSH_EVALCACHE_DIR"/init-*(N)
  return $ret
}
