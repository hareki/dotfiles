#!/bin/zsh

build() {
  local -a targets=(atuin eza television worktrunk lazygit tmux)
  local target
  # mise shims every binary in the toolchains' own dirs (~/.cargo/bin, the versioned
  # go bin), which costs ~50ms per call, and a go upgrade strands anything installed
  # there. PATH puts this dir ahead of the mise shims instead
  local -x CARGO_INSTALL_ROOT=~/.local/opt GOBIN=~/.local/opt/bin

  case "$1" in
    --list) print -l all $targets; return 0 ;;
    --help|"")
      print "Usage: build <target>"
      print "Available targets: all, ${(j:, :)targets}"
      return 0
      ;;
    all)
      for target in $targets; do
        print-header "Building $target"
        (cd $REPOS_DIR/$target && git pull && build $target) || print -P "%F{red}==> Failed to build $target%f" >&2
      done
      ;;
    atuin)                    cargo install --locked --path crates/atuin ;;
    eza|television|worktrunk) cargo install --locked --path . ;;
    lazygit)                  go install ;;
    tmux)
        # Installing explicitly marks them installed_on_request, so `brew
        # autoremove` won't reap deps of a binary brew can't see
        brew install libevent utf8proc jemalloc \
        && sh autogen.sh \
        && ./configure --enable-utf8proc --enable-jemalloc \
        && make clean \
        && make \
        && sudo make install
      ;;
    *)
      print "Unknown target: $1" >&2
      build --help
      return 1
      ;;
  esac

  local ret=$?
  _evalcache_clear
  return $ret
}
