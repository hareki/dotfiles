#!/bin/zsh

yay() {
  # One failing updater (a single brew cask can fail `brew upgrade`) must not skip the rest
  local -a failed

  print-header "Updating Homebrew"
  brew update && brew upgrade -y && brew autoremove || failed+=(Homebrew)

  print-header "Updating Antidote"
  antidote update || failed+=(Antidote)

  print-header "Updating Mise"
  mise install && mise upgrade || failed+=(Mise)

  print-header "Updating TPM"
  ~/.tmux/plugins/tpm/bin/clean_plugins \
    && ~/.tmux/plugins/tpm/bin/install_plugins \
    && ~/.tmux/plugins/tpm/bin/update_plugins all || failed+=(TPM)

  _evalcache_clear

  if (( $#failed )); then
    print -P "\n%F{red}==> Failed to update: ${(j:, :)failed}%f" >&2
    return 1
  fi
}
