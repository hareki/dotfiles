#!/bin/zsh

# tmuxinator's 80x24 layouts skew on attach, so run it in a terminal-sized throwaway session
mux() {
  if [[ -n $TMUX ]]; then
    tmuxinator start "$@"
  else
    # One quoted string: tmux splits an argument ending in `;` off as a separate command
    tmux new-session zsh -c "tmuxinator start ${(j: :)${(q)@}} ||
      { print -P '%F{red}mux: tmuxinator failed, press any key to close%f'; read -sk1 }"
  fi
}
