#!/bin/zsh

# Snapshots every tmux session with tmux-resurrect, then quits each pane's nvim through its normal
# exit (so auto-session saves its session), one at a time, ends each pane's Claude Code session and
# kills the server; -c/--continue stops after the snapshot. Pane nvims publish their RPC address as
# @nvim-server (nvim's core/auto-session/tsave.lua), the Claude Code sessions in the panes are the
# tmux package's claude-panes.zsh's to list, and nothing is quit or killed while any nvim holds
# work a kill would lose or any of those sessions, a pane nvim's terminal's included, is in the
# middle of a turn
tsave() {
  local keep_running=0
  case $1 in
    -c|--continue) keep_running=1 ;;
    -h|--help)
      print 'Usage: tsave [-c|--continue]   # --continue: snapshot only, leave nvim, claude and tmux running'
      return 0
      ;;
    '') ;;
    *)
      print -u2 "tsave: unknown option: $1"
      return 1
      ;;
  esac

  # In a pane nvim's terminal, quitting that nvim would end tsave before the kill, and the checks
  # below would count their own RPC client as a nested nvim: rerun from the tmux server, outside
  # every nvim, with the report in view mode on this pane. It returns only when tsave stops short
  # of the kill, since a full run quits this shell's nvim first
  if (( ! keep_running )) && [[ -n $NVIM && -n $TMUX_PANE ]]; then
    local job="autoload -Uz ${(q)functions_source[tsave]} && tsave"
    # -E keeps the stderr run-shell drops, `true` drops its "returned 1" line, and without NVIM the
    # rerun can't take this branch again, whatever environment the server gives its jobs
    tmux run-shell -E -t $TMUX_PANE "env -u NVIM zsh -fc ${(qq)job}; true"
    return 1
  fi

  # The snapshot files are the tmux package's resurrect-snapshots.zsh's to name and keep. Any
  # failure, a missing script included, must stop here, before anything is quit
  local saved id
  saved=$($HOME/.config/tmux/scripts/resurrect-snapshots.zsh save)
  case $? in
    0) ;;
    1)
      print -u2 'tsave: no tmux server with tmux-resurrect loaded'
      return 1
      ;;
    *)
      print -u2 'tsave: the snapshot was not saved, nothing quit or killed'
      return 1
      ;;
  esac
  id=${saved#* }
  if [[ $saved == unchanged\ * ]]; then
    print "Unchanged since snapshot $id, its expiry restarts"
  else
    print "Saved snapshot $id"
  fi
  (( keep_running )) && return 0

  # Nothing is quit until every pane checks out, so a refusal leaves everything running
  local -a blocked panes ttys fields
  local -A target_of tty_of cmd_of addr_of nvims_on
  local line pane tty comm out pid state where unreachable
  for line in ${(f)"$(tmux list-panes -a -F $'#{pane_id}\t#{session_name}:#{window_index}.#{pane_index}\t#{pane_tty}\t#{pane_current_command}\t#{@nvim-server}')"}; do
    fields=("${(@ps:\t:)line}")
    pane=$fields[1]
    # To a client without a UTF-8 locale tmux prints each tab as `_`: with no pane to check, every
    # check below would pass
    if (( $#fields != 5 )) || [[ $pane != %<-> ]]; then
      print -u2 "tsave: snapshot $id kept, tmux left running: its panes can't be listed (no UTF-8 locale?)"
      return 1
    fi
    # Grouped sessions list their shared panes once per session
    (( $+target_of[$pane] )) && continue
    panes+=($pane)
    target_of[$pane]=$fields[2]
    tty_of[$pane]=${fields[3]#/dev/}
    cmd_of[$pane]=$fields[4]
    addr_of[$pane]=$fields[5]
    ttys+=(-t $tty_of[$pane])
  done

  # The Claude Code sessions in the panes. Unless they can be listed this stops here too: one in
  # the middle of a turn would die with the server
  local -a claudes
  local -A claude_pane claude_busy
  if ! out=$($HOME/.config/tmux/scripts/claude-panes.zsh); then
    print -u2 "tsave: snapshot $id kept, tmux left running: the Claude Code sessions can't be listed"
    return 1
  fi
  for line in ${(f)out}; do
    fields=("${(@ps:\t:)line}")
    pid=$fields[3]
    # Grouped sessions list a shared pane's Claude once per session too
    (( $+claude_pane[$pid] )) && continue
    claude_pane[$pid]=$fields[1]
    # Only idle is safe to end: busy is a turn, waiting an answer one needs to finish, and a status
    # Claude Code gives no name could be either
    if [[ $fields[4] != idle ]]; then
      claude_busy[$fields[1]]+=${fields[4]:-in an unknown state}$'\n'
    # tsave ends the one a pane runs itself. One in an nvim's terminal ends with that nvim
    elif [[ $fields[6] == foreground ]]; then
      claudes+=($pid)
    fi
  done

  # Every nvim TUI on a pane's tty: a suspended (Ctrl-Z) or background one dies with the server.
  # ps lists no process at all once one tty is gone (a pane that closed since they were listed)
  ps -o tty=,comm= $ttys | while read -r tty comm; do
    [[ ${comm:t} == nvim ]] && (( nvims_on[$tty]++ ))
  done
  if (( pipestatus[1] )); then
    print -u2 "tsave: snapshot $id kept, tmux left running: the panes' processes can't be listed"
    return 1
  fi

  local -a rpc=(timeout 2 /opt/homebrew/bin/nvim --headless --server)
  local -a quit
  for pane in $panes; do
    where=
    [[ $cmd_of[$pane] == nvim ]] && where=" in nvim's terminal"
    for state in ${(f)claude_busy[$pane]}; do
      blocked+=("$target_of[$pane]: claude is $state$where")
    done
    if [[ $cmd_of[$pane] != nvim ]]; then
      (( nvims_on[$tty_of[$pane]] )) && blocked+=("$target_of[$pane]: a suspended or background nvim")
      continue
    fi
    unreachable="$target_of[$pane]: nvim isn't reachable (started before this config, or with --clean)"
    if (( nvims_on[$tty_of[$pane]] > 1 )); then
      blocked+=("$target_of[$pane]: a suspended or background nvim besides the running one")
    elif [[ -z $addr_of[$pane] ]]; then
      blocked+=($unreachable)
    else
      # --headless: with a tty on any std stream, `--remote-expr` starts a UI instead
      out=$($rpc $addr_of[$pane] --remote-expr "v:lua.require'core.auto-session.tsave'.unsaved()" </dev/null 2>/dev/null)
      case $? in
        0)
          if [[ -n $out ]]; then
            blocked+=("$target_of[$pane]: ${(j:, :)${(f)out}}")
          else
            quit+=($pane)
          fi
          ;;
        # timeout's status: the nvim is there, and answers nothing
        124) blocked+=("$target_of[$pane]: nvim didn't answer (waiting on a prompt?)") ;;
        # Nothing listens at the address: an nvim that ran in the pane before this one left it
        *) blocked+=($unreachable) ;;
      esac
    fi
  done

  if (( $#blocked )); then
    print -u2 "tsave: snapshot $id kept, tmux left running:"
    print -u2 -l -- "  "${^blocked}
    return 1
  fi

  # Claude Code's clean exit: its SessionEnd hooks run
  (( $#claudes )) && kill -TERM $claudes 2>/dev/null

  # One nvim at a time, each given 10s to go before the next is asked to: nvims that write their
  # ShaDa file at the same moment collide (E137, and E138 once the temp files those collisions
  # leave have used up .tmp.a to .tmp.z), and the one that loses waits at a hit-enter prompt
  # instead of exiting. A pane (or the whole server) that is gone has finished quitting too
  for pane in $quit; do
    $rpc $addr_of[$pane] --remote-expr "v:lua.require'core.auto-session.tsave'.quit()" </dev/null &>/dev/null
    repeat 200; do
      [[ $(tmux display-message -p -t $pane '#{pane_current_command}' 2>/dev/null) == nvim ]] || break
      sleep 0.05
    done
  done

  local -a running nvims late
  repeat 100; do
    late=()
    for pid in $claudes; do
      kill -0 $pid 2>/dev/null && late+=("claude in $target_of[$claude_pane[$pid]]")
    done
    (( $#late )) || break
    sleep 0.1
  done
  nvims=(${(f)"$(tmux list-panes -a -f '#{==:#{pane_current_command},nvim}' -F '#{pane_id}' 2>/dev/null)"})
  for pane in ${quit:*nvims}; do running+=("nvim in $target_of[$pane]"); done
  running+=($late)
  if (( $#running )); then
    print -u2 "tsave: snapshot $id kept, but still running: ${(j:, :)running}"
    print -u2 '  finish there, then run `tmux kill-server`: a new tsave would save the quit panes as plain shells'
    return 1
  fi

  tmux kill-server 2>/dev/null
  return 0
}
