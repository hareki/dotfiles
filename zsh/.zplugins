# Only the omz libs this config uses, not all of lib (~2ms per shell); plugins.zsh sets
# the variables they read, since omz's own loader isn't used either
ohmyzsh/ohmyzsh path:lib/completion.zsh
ohmyzsh/ohmyzsh path:lib/directories.zsh
ohmyzsh/ohmyzsh path:lib/functions.zsh
ohmyzsh/ohmyzsh path:lib/grep.zsh
ohmyzsh/ohmyzsh path:lib/history.zsh
ohmyzsh/ohmyzsh path:lib/key-bindings.zsh
ohmyzsh/ohmyzsh path:lib/misc.zsh
ohmyzsh/ohmyzsh path:lib/termsupport.zsh
ohmyzsh/ohmyzsh path:lib/theme-and-appearance.zsh
ohmyzsh/ohmyzsh path:lib/vcs_info.zsh
ohmyzsh/ohmyzsh path:plugins/ssh-agent kind:defer
romkatv/powerlevel10k

# autosuggestions goes last: with ZSH_AUTOSUGGEST_MANUAL_REBIND it wraps the widgets
# that exist when it loads, and nothing afterwards
Aloxaf/fzf-tab kind:defer
zsh-users/zsh-autosuggestions kind:defer
