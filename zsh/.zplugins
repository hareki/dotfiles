# Only the omz libs this config uses, not all of lib (~5ms per shell)
ohmyzsh/ohmyzsh path:lib/completion.zsh
ohmyzsh/ohmyzsh path:lib/functions.zsh
ohmyzsh/ohmyzsh path:lib/history.zsh
ohmyzsh/ohmyzsh path:lib/key-bindings.zsh
ohmyzsh/ohmyzsh path:lib/misc.zsh
ohmyzsh/ohmyzsh path:lib/termsupport.zsh
ohmyzsh/ohmyzsh path:plugins/ssh-agent kind:defer
romkatv/powerlevel10k
Aloxaf/fzf-tab kind:defer
zsh-users/zsh-autosuggestions kind:defer
